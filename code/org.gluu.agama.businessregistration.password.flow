Flow org.gluu.agama.businessregistration.password
     Basepath ""
     Timeout 900 seconds
     Inputs service
pwdUiFeedback = {}
pwdUiFeedback.errorMessage = ""
pwdUiFeedback.infoMessage = ""
Repeat 4 times max
     passwordInput = RRF "businessPassword.ftlh" pwdUiFeedback
     When passwordInput.back is "yes"
          Log "@info Password back requested"
          it_kewqa = {success:false, error: "BackToProfile"}
          Finish it_kewqa
     Otherwise
          passwordValidation = Call service validateBusinessPassword passwordInput
          Log "@info Password validation: % , %" passwordValidation.valid passwordValidation.message
          When passwordValidation.valid is true
               Log "@info Password validated - returning to parent"
               it_ok = {}
               it_ok.success = true
               it_ok.userPassword = passwordInput.userPassword
               it_ok.confirmPassword = passwordInput.confirmPassword
               Finish it_ok
          Otherwise
               pwdUiFeedback.errorMessage = passwordValidation.message
Log "@error Password loop exhausted"
it_oxqsv = {success:false, error: "ExceededTheNumberOfAttemptsAllowed"}
Finish it_oxqsv