//   Business User Registration - Jans availability -> personal phone OTP -> MWAPP KYC gate
Flow org.gluu.agama.businessregistration.signup
     Basepath ""
     Timeout 300000 seconds
     Configs conf
//   Initialize UI feedback object
uiFeedback = {}
//   Build the service singleton from project config
service = Call org.gluu.agama.businessuser.BusinessUserRegistration#getInstance conf
uiFeedback.errorMessage = ""
uiFeedback.infoMessage = ""
//   Outer loop on personal-username entry - 3 attempts max
Repeat 3 times max
     //   Step 1: collect personal username + first verification method
     personalInput = RRF "personalUsername.ftlh" uiFeedback
     personalUid = personalInput.personalUid
     verificationMethod1 = personalInput.verificationMethod
     Log "@info Personal username submitted: " personalUid
     //   Step 2: Jans availability - get phone + lang for sending OTP (no MWAPP yet, no leak)
     personalUser = Call service getPersonalUserDetails personalUid
     When personalUser.empty is true
          //   Unified surface: doesn't exist / inactive / no mobile / phoneNumberVerified != true / is a business account
          Log "@error Jans availability check failed for: " personalUid
          uiFeedback.errorMessage = "Unable to continue with this account"
          personalInum = personalUser.inum
          personalPhone = personalUser.mobile
          personalLang = personalUser.lang
     Otherwise
          Log "@info Jans availability passed for: " personalUid
          //   Step 3: send personal-phone OTP and launch verification subflow
          smsOtpSend = Call service sendOTPCode personalPhone personalLang verificationMethod1
          When smsOtpSend is null
               Log "@error Personal phone OTP send failed for: " personalUid
               uiFeedback.errorMessage = "Phone verification failed. Please contact customer support"
          Otherwise
               Log "@info Personal phone OTP sent to: " personalPhone
               firstOtpResult = Trigger org.gluu.agama.businessregistration.verifyphoneotp service personalPhone personalLang verificationMethod1
               Log "@info First OTP subflow result: " firstOtpResult
               When firstOtpResult.success is true
                    Log "@info Personal phone OTP verified - running post-OTP MWAPP gate"
                    //   Step 4: MWAPP KYC + face + phone gate. User has proven phone ownership, so KYC reveal is safe.
                    kycOk = Call service isPersonalVerified personalUid
                    When kycOk is false
                         Log "@error MWAPP gate failed post-OTP for: " personalUid
                         it_gcnpq = {success:false, error: ""IncompletePersonalAccountSetup""}
                         Finish it_gcnpq
                    Log "@info MWAPP gate passed - entering business profile loop"
                    uiFeedback.errorMessage = ""
                    uiFeedback.infoMessage = ""
                    //   Step 6+: business profile entry loop - 4 attempts max
                    Repeat 4 times max
                         businessProfile = RRF "businessProfile.ftlh" uiFeedback
                         validation = Call service validateBusinessInputs businessProfile
                         Log "@info Business profile validation: % , % , %" validation validation.valid validation.message
                         When validation.valid is true
                              //   Step 7: uniqueness checks
                              businessMailUser = Call service getUserEntityByMail businessProfile.mail
                              When businessMailUser.empty is true
                                   businessUidUser = Call service getUserEntityByUsername businessProfile.uid
                                   When businessUidUser.empty is true
                                        //   Step 8: send email OTP
                                        emailOtpCode = Call service sendEmail businessProfile.mail businessProfile.lang
                                        When emailOtpCode is null
                                             uiFeedback.errorMessage = "Failed to send OTP. Please try again."
                                        Otherwise
                                             Log "@info Business email OTP sent to: " businessProfile.mail
                                             emailResendCount = 0
                                             emailValidationAttempts = 0
                                             uiFeedback.errorMessage = ""
                                             uiFeedback.infoMessage = ""
                                             Repeat 20 times max
                                                  uiFeedback.email = businessProfile.mail
                                                  emailOtpCreds = RRF "otp.ftlh" uiFeedback
                                                  When emailOtpCreds.resend is "yes"
                                                       Log "@info Business email OTP resend requested"
                                                       When emailResendCount is 3
                                                            Log "@error Email OTP resend exceeded"
                                                            it_itoyi = {success:false, error: ""ExceededTheNumberOfAttemptsAllowed""}
                                                            Finish it_itoyi
                                                       emailResendCount = Call org.gluu.agama.newregistration.CounterHelper#increment emailResendCount
                                                       Log "@info Email resend attempt: " emailResendCount
                                                       emailOtpCode = Call service sendEmail businessProfile.mail businessProfile.lang
                                                       When emailOtpCode is null
                                                            uiFeedback.errorMessage = "Failed to send OTP. Please try again."
                                                            uiFeedback.infoMessage = ""
                                                       Otherwise
                                                            uiFeedback.errorMessage = ""
                                                            uiFeedback.infoMessage = "A new OTP code has been send to your business email"
                                                  Otherwise
                                                       Log "@info Business email OTP submitted by user"
                                                       emailValidationAttempts = Call org.gluu.agama.newregistration.CounterHelper#increment emailValidationAttempts
                                                       When emailValidationAttempts is 4
                                                            Log "@error Email OTP validation exceeded"
                                                            it_ocbxh = {success:false, error: ""ExceededTheNumberOfAttemptsAllowed""}
                                                            Finish it_ocbxh
                                                       Otherwise
                                                            emailOtpOk = Call service validateEmailOTP businessProfile.mail emailOtpCreds.passcode
                                                            When emailOtpOk is true
                                                                 Log "@info Business email OTP verified - creating business user"
                                                                 //   Step 9: create business user in LDAP with jansExtUid linkage
                                                                 businessInum = Call service addNewBusinessUser businessProfile personalInum personalPhone
                                                                 When businessInum is not null
                                                                      Log "@info Business user created with inum: " businessInum
                                                                      //   Send welcome email to business email
                                                                      sendemailStatus = Call service sendAccountCreationNotificationEmail businessProfile.mail businessProfile.uid businessProfile.lang
                                                                      Log "@info Welcome email status: " sendemailStatus
                                                                      //   Step 10+: business-phone confirmation loop - 3 attempts max
                                                                      uiFeedback.phone = personalPhone
                                                                      uiFeedback.errorMessage = ""
                                                                      uiFeedback.infoMessage = ""
                                                                      Repeat 3 times max
                                                                           phoneConfirmInput = RRF "ConfirmBusinessPhone.ftlh" uiFeedback
                                                                           verificationMethod2 = phoneConfirmInput.verificationMethod
                                                                           secondSend = Call service sendOTPCode personalPhone businessProfile.lang verificationMethod2
                                                                           Log "@info Second OTP sent for business phone confirmation"
                                                                           secondOtpResult = Trigger org.gluu.agama.businessregistration.verifyphoneotp service personalPhone businessProfile.lang verificationMethod2
                                                                           Log "@info Second OTP subflow result: " secondOtpResult
                                                                           When secondOtpResult.success is true
                                                                                //   Step 12: stamp telephoneNumber + phoneNumberVerified
                                                                                phoneVerified = Call service markPhoneAsVerified businessProfile.uid personalPhone
                                                                                Log "@info Business phone marked verified: " phoneVerified
                                                                                //   Step 13: acknowledgement and successful finish
                                                                                acknowledgementInput = RRF "acknowledgement.ftlh" 
                                                                                Log "@info Business registration completed for uid: " businessProfile.uid
                                                                                Finish businessProfile.uid
                                                                           Otherwise
                                                                                When secondOtpResult.error is "ExceededTheNumberOfAttemptsAllowed"
                                                                                     Log "@error Second OTP validation attempts exceeded"
                                                                                     Finish secondOtpResult
                                                                                When secondOtpResult.error is "ExceededResendAttempts"
                                                                                     Log "@error Second OTP resend attempts exceeded"
                                                                                     Finish secondOtpResult
                                                                                uiFeedback.errorMessage = "Phone confirmation failed. Try once more."
                                                                      Log "@error Confirmation phone loop exhausted"
                                                                      it_jbjto = {success:false, error: ""ExceededTheNumberOfAttemptsAllowed""}
                                                                      Finish it_jbjto
                                                                 //   Business creation failed - log and let outer loop retry profile entry
                                                                 Log "@error @error Business user creation failed - returned null"
                                                                 uiFeedback.errorMessage = "Business account creation failed. Please try again."
                                                            Otherwise
                                                                 Log "@error Invalid email OTP"
                                                                 uiFeedback.errorMessage = "Invalid OTP. Please try again."
                                                                 uiFeedback.infoMessage = ""
                                             //   Email loop fell through without Finish - exhausted
                                             Log "@error Email OTP loop completed without success"
                                             it_irqcl = {success:false, error: ""ExceededTheNumberOfAttemptsAllowed""}
                                             Finish it_irqcl
                                   Otherwise
                                        Log "@error Business username already taken: " businessProfile.uid
                                        uiFeedback.errorMessage = "The business username is not available."
                              Otherwise
                                   Log "@error Business email already in use: " businessProfile.mail
                                   uiFeedback.errorMessage = "This business email is already registered. Please use a different one."
                                   uiFeedback.errorMessage = validation.message
                    //   Business profile loop exhausted (4 attempts)
                    Log "@error Business profile loop exhausted"
                    it_yfhbw = {success:false, error: ""ExceededTheNumberOfAttemptsAllowed""}
                    Finish it_yfhbw
               Otherwise
                    //   First OTP subflow failed - surface specific subflow errors immediately
                    When firstOtpResult.error is "ExceededTheNumberOfAttemptsAllowed"
                         Log "@error First OTP validation attempts exceeded"
                         Finish firstOtpResult
                    When firstOtpResult.error is "ExceededResendAttempts"
                         Log "@error First OTP resend attempts exceeded"
                         Finish firstOtpResult
                    uiFeedback.errorMessage = "Phone verification failed. Please contact customer support"
//   Outer Repeat (3 attempts) exhausted - too many attempts
Log "@error Personal lookup loop exhausted"
it_ulzzh = {success:false, error: ""ExceededTheNumberOfAttemptsAllowed""}
Finish it_ulzzh